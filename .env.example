# Backend API endpoints
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8000

# Google Maps JavaScript API key — restrict by HTTP referrer in the GCP
# console (this is exposed client-side by design; it is NOT a secret
# like the backend's GEMINI_API_KEY and must never be that same key).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

