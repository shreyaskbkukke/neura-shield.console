# NeuraShield Web Console Environment Variables
# Copy this file to .env.local and fill in the values.

# Backend API endpoints
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8000

# Dev auth bypass (set true for local development — uses X-Dev-User-Id header)
NEXT_PUBLIC_DEV_AUTH_ENABLED=true

# Default dev user UUID (e.g. ADMIN UUID from backend seeding: 11111111-1111-1111-1111-111111111111)
NEXT_PUBLIC_DEFAULT_DEV_USER_ID=11111111-1111-1111-1111-111111111111
